{
  "name": "@lfvs/importer-vocaloard-youtube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./client": "./client/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "cordis": {
    "public": [
      "dist"
    ],
    "description": {
      "en": "Import missing YouTube videos from Vocaloard rankings",
      "zh": "从 Vocaloard 排行榜导入缺失的 YouTube 视频"
    },
    "service": {
      "implements": [
        "vocaloardYouTubeImporter"
      ],
      "required": [
        "mediaSync",
        "http",
        "cron",
        "webui"
      ]
    }
  },
  "peerDependencies": {
    "@cordisjs/client": "^0.8.2",
    "@cordisjs/plugin-http": "^1.5.1",
    "@cordisjs/plugin-webui": "^0.8.2",
    "@lfvs/core": "^0.1.0",
    "cordis": "^4.0.0-rc.7",
    "cordis-plugin-cron": "^0.1.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "schemastery": "^3.18.0"
  }
}
