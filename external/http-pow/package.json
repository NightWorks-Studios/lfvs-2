{
  "name": "@lfvs/http-pow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "cordis": {
    "description": {
      "en": "Proof-of-work middleware for Cordis HTTP routes",
      "zh": "用于 Cordis HTTP 路由的工作量证明中间件"
    },
    "service": {
      "implements": [
        "httpPow"
      ],
      "required": [
        "server"
      ]
    }
  },
  "peerDependencies": {
    "@cordisjs/plugin-server": "^1.7.0",
    "cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "path-to-regexp-typed": "^8.0.0",
    "schemastery": "^3.18.0"
  }
}
