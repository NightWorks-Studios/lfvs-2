{
  "name": "@lfvs/webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./client": "./client/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "cordis": {
    "public": [
      "dist"
    ],
    "description": {
      "en": "LFVS resource dashboard and runtime inspector",
      "zh": "LFVS 资源检索、历史趋势与运行状态"
    },
    "service": {
      "required": [
        "mediaSync",
        "database",
        "webui"
      ]
    }
  },
  "peerDependencies": {
    "@cordisjs/client": "^0.8.2",
    "@cordisjs/plugin-database": "^4.1.1",
    "@cordisjs/plugin-webui": "^0.8.2",
    "@lfvs/core": "^0.1.0",
    "cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "@lucide/vue": "^1.33.0",
    "echarts": "^6.0.0"
  }
}
