{
  "name": "@lfvs/updater-youtube-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "cordis": {
    "service": {
      "implements": [
        "youtubeVideoUpdater"
      ],
      "required": [
        "mediaSync",
        "cron"
      ]
    }
  },
  "peerDependencies": {
    "@lfvs/core": "^0.1.0",
    "cordis": "^4.0.0-rc.7",
    "cordis-plugin-cron": "^0.1.0"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
