{
  "name": "@lfvs/updater-bilibili-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "cordis": {
    "services": {
      "implements": [
        "bilibiliVideoUpdater"
      ],
      "required": [
        "mediaSync",
        "database",
        "timer"
      ]
    }
  },
  "peerDependencies": {
    "@cordisjs/plugin-database": "^4.1.1",
    "@cordisjs/plugin-timer": "^1.1.2",
    "@lfvs/core": "^0.1.0",
    "cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
