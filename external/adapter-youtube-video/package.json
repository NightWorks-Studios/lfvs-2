{
  "name": "@lfvs/adapter-youtube-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "cordis": {
    "description": {
      "en": "Fetch YouTube video and channel details through YouTube Data API v3",
      "zh": "通过 YouTube Data API v3 获取 YouTube 视频和频道详情"
    },
    "service": {
      "required": [
        "mediaSync",
        "http"
      ]
    }
  },
  "peerDependencies": {
    "@cordisjs/plugin-http": "^1.5.1",
    "@lfvs/core": "^0.1.0",
    "cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
