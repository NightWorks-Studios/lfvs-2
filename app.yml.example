- id: 312edd83
  name: '@cordisjs/plugin-timer'
- id: lfvs-cron
  name: 'cordis-plugin-cron'
- id: 0a9ec786
  name: '@cordisjs/plugin-http'
- id: 4cd8d0ee
  name: '@cordisjs/plugin-http-socks'
- id: fa2b056a
  name: '@cordisjs/plugin-server'
  config:
    port: 3140
- id: aa143c36
  name: '@cordisjs/plugin-server-acl'
- id: 8357f09b
  name: '@cordisjs/plugin-group'
  label: Database
  config:
    - id: 5b69b05e
      name: '@cordisjs/plugin-database'
    - id: 07c0d352
      name: '@cordisjs/plugin-database-sqlite'
      config:
        path: ./data/cordis.db
    - id: lfvs-core
      name: '@lfvs/core'
    - id: lfvs-adapter-bilibili-video
      name: '@lfvs/adapter-bilibili-video'
      config:
        # 对接 bilibili-rs-gateway: https://github.com/Roberta001/bilibili-rs-gateway
        # 批量视频信息接口地址。
        endpoint: http://127.0.0.1:3011/api/view/batch
        # 单次请求允许传入的最大 BVID 数。
        maxBatchSize: 250
        # 上游请求超时时间（毫秒）。
        requestTimeoutMs: 30000
    - id: lfvs-updater-bilibili-video
      name: '@lfvs/updater-bilibili-video'
      config:
        # 更新任务的 CRON 表达式，默认每小时整点执行。
        cron: '0 * * * *'
        # 每批交给适配器更新的资源数。
        batchSize: 250
        # 同时向适配器发起的批次数。
        concurrency: 4
        # 启动时不主动更新，仅等待 CRON 触发。
        runImmediately: false
    - id: lfvs-importer-vocabili
      name: '@lfvs/importer-vocabili'
      config:
        # Vocabili API 的基础地址。
        apiBase: https://api.vocabili.top
        # 要导入的 Vocabili 榜单名称。
        boardName: vocaloid-daily
        # 可选的 HTTP 代理地址，留空则直接访问。
        proxyAgent: ''
        # 导入任务的 CRON 表达式。
        cron: '0 * * * *'
        # 每次从 Vocabili 获取的条目数。
        pageSize: 20
        # 每次请求视频适配器的 BVID 数。
        batchSize: 250
        # 同时向视频适配器发起的批次数。
        concurrency: 4
        # 启动后是否立刻导入一次。
        runImmediately: true
    - id: 0cb55d6c
      name: '@cordisjs/plugin-database-mysql'
      disabled: true
    - id: ae5ffd0d
      name: '@cordisjs/plugin-database-postgres'
      disabled: true
    - id: 5c1993ac
      name: '@cordisjs/plugin-database-mongo'
      disabled: true
- id: 7bf6f701
  name: '@cordisjs/plugin-group'
  label: SSO
  config:
    - id: ee017963
      name: '@cordisjs/plugin-sso'
    - id: 8d3a0f12
      name: '@cordisjs/plugin-sso-server'
    - id: 45bc2d91
      name: '@cordisjs/plugin-sso-password'
    - id: 03dd4465
      name: '@cordisjs/plugin-sso-webauthn'
      disabled: true
    - id: dcff0bd1
      name: '@cordisjs/plugin-sso-oauth'
      disabled: true
- id: 0c9db8e2
  name: '@cordisjs/plugin-group'
  label: WebUI
  config:
    - id: 4430a808
      name: '@cordisjs/plugin-webui'
    - id: f64a9366
      name: '@cordisjs/plugin-database-webui'
    - id: lfvs-webui
      name: '@lfvs/webui'
    - id: 03ebc689
      name: '@cordisjs/plugin-http-webui'
    - id: 8a9b6184
      name: '@cordisjs/plugin-insight'
    - id: 7c7aff7a
      name: '@cordisjs/plugin-loader-webui'
    - id: 7adac547
      name: '@cordisjs/plugin-logger-webui'
    - id: afe4937f
      name: '@cordisjs/plugin-market'
    - id: 539bc93a
      name: '@cordisjs/plugin-notifier'
    - id: 126b4c42
      name: '@cordisjs/plugin-server-webui'
    - id: f9c1a8b2
      name: '@cordisjs/plugin-webui-sso'
- id: 375b963c
  name: '@cordisjs/plugin-group'
  label: Development
  config:
    - id: e1e36558
      name: '@cordisjs/plugin-hmr'
      config:
        root:
          - external
          - packages
          - app.yml
