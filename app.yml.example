- id: 312edd83
  name: '@cordisjs/plugin-timer'
- id: lfvs-cron
  name: 'cordis-plugin-cron'
- id: 0a9ec786
  name: '@cordisjs/plugin-http'
- id: 4cd8d0ee
  name: '@cordisjs/plugin-http-socks'
- id: fa2b056a
  name: '@cordisjs/plugin-server'
  config:
    port: 3140
- id: aa143c36
  name: '@cordisjs/plugin-server-acl'
- id: 8357f09b
  name: '@cordisjs/plugin-group'
  label: Database
  config:
    - id: 5b69b05e
      name: '@cordisjs/plugin-database'
    - id: 07c0d352
      name: '@cordisjs/plugin-database-sqlite'
      config:
        path: ./data/cordis.db
    - id: lfvs-core
      name: '@lfvs/core'
    - id: lfvs-http-pow
      name: '@lfvs/http-pow'
      config:
        # 必须与 API 的 basePath 一致；使用 server 前置中间件，不依赖插件加载顺序。
        basePath: /api/v1
        # 需要 PoW 验证的相对路径。路径语法与 Cordis server 路由一致。
        lightPaths:
          - /targets
          - /targets/:platform/:kind/schema
        normalPaths:
          - /targets/:platform/:kind/resources
          - /targets/:platform/:kind/resources/batch
          - /targets/:platform/:kind/resources/:id/history
          - /targets/:platform/:kind/resources/:id
          - /targets/:platform/:kind/authors
          - /targets/:platform/:kind/authors/:id/resources
          - /targets/:platform/:kind/authors/:id
        bulkPaths:
          - /targets/:platform/:kind/resources/snapshot
        # Challenge 签名密钥。生产环境请设置至少 32 字节的随机值；留空时每次启动随机生成。
        secret: ''
        # Challenge 有效时间和允许的时钟偏差。
        challengeTtlMs: 60000
        clockSkewMs: 5000
        # 默认不信任代理头；仅当服务只能经可信反向代理访问时开启。
        trustProxy: false
        # Challenge 默认与客户端精确 IP 绑定，也可设为 prefix 或 none。
        ipBinding: exact
        ipv4Prefix: 24
        ipv6Prefix: 56
        # 三类接口要求的 SHA-256 前导零位数。
        lightDifficulty: 18
        normalDifficulty: 20
        bulkDifficulty: 22
        # 全量 bulk 接口：单并发、每客户端 5 分钟冷却。
        bulkConcurrency: 1
        bulkCooldownMs: 300000
        bulkClientCacheSize: 10000
        # Challenge 签发限速：每个客户端每秒恢复额度和最大突发额度。
        challengeRatePerSecond: 2
        challengeBurst: 10
        # 内存防重放、客户端限速缓存上限和清理周期。
        replayCacheSize: 100000
        clientCacheSize: 10000
        cleanupIntervalMs: 30000
        # 应与 API 的 CORS 来源保持一致。
        corsOrigins:
          - '*'
    - id: lfvs-api
      name: '@lfvs/api'
      config:
        # API 路由前缀。
        basePath: /api/v1
        # 列表接口默认返回数量和最大返回数量。
        defaultLimit: 50
        maxLimit: 250
        # 批量资源接口单次允许提交的最大 ID 数量。
        maxBatchSize: 250
        # 历史记录接口单次允许返回的最大快照数量。
        maxHistoryPoints: 5000
        # 允许跨域访问 API 的来源；生产环境建议改为明确的来源列表。
        corsOrigins:
          - '*'
    - id: lfvs-adapter-bilibili-video
      name: '@lfvs/adapter-bilibili-video'
      config:
        # 对接 bilibili-rs-gateway: https://github.com/Roberta001/bilibili-rs-gateway
        # 批量视频信息接口地址。
        endpoint: http://127.0.0.1:3011/api/view/batch
        # 单次请求允许传入的最大 BVID 数。
        maxBatchSize: 250
        # 上游请求超时时间（毫秒）。
        requestTimeoutMs: 30000
    - id: lfvs-updater-bilibili-video
      name: '@lfvs/updater-bilibili-video'
      config:
        # 更新任务的 CRON 表达式，默认每小时整点执行。
        cron: '0 * * * *'
        # 每批交给适配器更新的资源数。
        batchSize: 250
        # 同时向适配器发起的批次数。
        concurrency: 4
        # 启动时不主动更新，仅等待 CRON 触发。
        runImmediately: false
    - id: lfvs-adapter-youtube-video
      name: '@lfvs/adapter-youtube-video'
      config:
        # YouTube Data API v3 基础地址。
        endpoint: https://www.googleapis.com/youtube/v3
        # 可选的 HTTP 或 SOCKS 代理地址；留空则直连。
        proxyAgent: ''
        # 每行一个可用 API Key。该本地文件已被 Git 忽略，可在此改为其他路径。
        keyFile: ./data/youtube-api-keys.txt
        # 额外 API Key；留空时仅使用 keyFile。Key 会自动轮询，配额耗尽后冷却至太平洋时间午夜。
        apiKeys: []
        # YouTube API 每次最多查询 50 个视频或频道 ID。
        maxBatchSize: 50
        # 单次 YouTube API 请求超时时间（毫秒）。
        requestTimeoutMs: 30000
        # 遇到 429 或 5xx 时换用其他 Key 的最大重试次数。
        maxTransientRetries: 3
    - id: lfvs-updater-youtube-video
      name: '@lfvs/updater-youtube-video'
      config:
        # 视频全量更新的 CRON 表达式，默认每小时整点执行。
        cron: '0 * * * *'
        # 每批交给适配器更新的视频数量，不能超过 50。
        batchSize: 50
        # 同时发起的适配器批次数；每批还会请求一次频道信息，适配器会在可用 API Key 间轮询。
        concurrency: 2
        # 启动时不主动更新，仅等待 CRON 触发。
        runImmediately: false
    - id: lfvs-importer-vocaloard-youtube
      name: '@lfvs/importer-vocaloard-youtube'
      config:
        # Vocaloard SSR 网站的基础地址。
        sourceBase: https://vocaloard.injpok.tokyo/
        # 访问 Vocaloard 使用的 HTTP 或 SOCKS 代理地址；留空则直连。
        proxyAgent: ''
        # 自动检查最新榜单的 CRON 表达式，默认每小时整点执行。
        cron: '0 * * * *'
        # 自动检查并导入的榜单模式：daily（普通日榜）、new-original（新着原创曲日榜）。
        autoModes:
          - daily
          - new-original
        # 同时请求 Vocaloard HTML 页面的最大数量；请控制为站点可承受的值。
        sourceConcurrency: 1
        # 两次 Vocaloard 请求开始时间的最小间隔（毫秒）。
        sourceRequestIntervalMs: 500
        # 每次交给 YouTube 适配器的视频 ID 数量，不能超过适配器上限 50。
        adapterBatchSize: 50
        # 同时执行的 YouTube 适配器批次数。
        adapterConcurrency: 4
        # 启动后是否立即检查最新榜单。
        runImmediately: true
    - id: lfvs-importer-vocabili
      name: '@lfvs/importer-vocabili'
      config:
        # Vocabili API 的基础地址。
        apiBase: https://api.vocabili.top
        # 要导入的 Vocabili 榜单名称。
        boardName: vocaloid-daily
        # 可选的 HTTP 代理地址，留空则直接访问。
        proxyAgent: ''
        # 导入任务的 CRON 表达式。
        cron: '0 * * * *'
        # 每次从 Vocabili 获取的条目数。
        pageSize: 20
        # 每次请求视频适配器的 BVID 数。
        batchSize: 250
        # 同时向视频适配器发起的批次数。
        concurrency: 4
        # 启动后是否立刻导入一次。
        runImmediately: true
    - id: 0cb55d6c
      name: '@cordisjs/plugin-database-mysql'
      disabled: true
    - id: ae5ffd0d
      name: '@cordisjs/plugin-database-postgres'
      disabled: true
    - id: 5c1993ac
      name: '@cordisjs/plugin-database-mongo'
      disabled: true
